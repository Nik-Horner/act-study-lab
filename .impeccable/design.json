  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "html": "<button class=\"ds-primary\">Continue lesson</button>",
      "css": ".ds-primary{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:10px 20px;border:0;border-bottom:3px solid rgb(15 35 80 / 13%);border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;transition:background .16s,transform .16s;background:var(--color-brand);color:var(--color-on-brand);}.ds-primary:hover{background:var(--color-brand-dark);}.ds-primary:focus-visible{outline:3px solid var(--color-brand);outline-offset:3px;}.ds-primary:active:not(:disabled){transform:translateY(1px);}.ds-primary:disabled{opacity:.5;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "html": "<button class=\"ds-ghost\">Review method</button>",
      "css": ".ds-ghost{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:10px 20px;border:0;border-bottom:3px solid rgb(15 35 80 / 13%);border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;transition:background .16s,transform .16s;background:var(--color-bg-raised);color:var(--color-ink);}.ds-ghost:hover{background:var(--color-border);}.ds-ghost:focus-visible{outline:3px solid var(--color-brand);outline-offset:3px;}.ds-ghost:active:not(:disabled){transform:translateY(1px);}.ds-ghost:disabled{opacity:.5;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none;}}"
    },
    {
      "name": "Danger button",
      "kind": "button",
      "refersTo": "button-danger",
      "html": "<button class=\"ds-danger\">Delete</button>",
      "css": ".ds-danger{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:10px 20px;border:0;border-bottom:3px solid rgb(15 35 80 / 13%);border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;transition:background .16s,transform .16s;background:var(--color-bad);color:var(--color-on-brand);}.ds-danger:hover{opacity:.9;}.ds-danger:focus-visible{outline:3px solid var(--color-brand);outline-offset:3px;}.ds-danger:active:not(:disabled){transform:translateY(1px);}.ds-danger:disabled{opacity:.5;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-danger{transition:none;}}"
    },
    {
      "name": "Daily time field",
      "kind": "input",
      "refersTo": "input",
      "html": "<label class=\"ds-label\" for=\"ds-minutes\">Minutes available each day</label><input id=\"ds-minutes\" class=\"ds-input\" type=\"number\" min=\"15\" max=\"240\" step=\"1\" value=\"60\" aria-describedby=\"ds-time-help\"><p id=\"ds-time-help\" class=\"ds-help\">15\u2013240 minutes. Lesson times are estimates.</p>",
      "css": ".ds-label{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:block;margin-bottom:4px;font-size:14px;font-weight:500;color:var(--color-ink);}.ds-input{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;min-height:44px;width:100%;padding:8px 12px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-bg);color:var(--color-ink);font-size:16px;accent-color:var(--color-brand);}.ds-input:focus-visible{outline:3px solid var(--color-brand);outline-offset:3px;}.ds-help{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;font-size:14px;color:var(--color-ink-soft);margin-top:8px;}"
    },
    {
      "name": "Desktop navigation",
      "kind": "nav",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#today\" aria-current=\"page\"><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 10 9-7 9 7v11h-6v-7H9v7H3z\"/></svg>Today</a><a href=\"#course\">Course</a><a href=\"#play\">Play</a><a href=\"#progress\">Progress</a></nav>",
      "css": ".ds-nav{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:grid;gap:9px;}.ds-nav a{display:flex;align-items:center;gap:18px;min-height:58px;padding:12px 18px;border-radius:14px;color:var(--color-ink);font-weight:650;text-decoration:none;transition:background .16s,color .16s;}.ds-nav a:hover{background:var(--color-bg-raised);}.ds-nav a[aria-current]{background:var(--color-brand);color:var(--color-on-brand);box-shadow:0 3px 6px -4px rgb(15 43 130 / 40%);}.ds-nav a:focus-visible{outline:3px solid var(--color-brand);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none;}}"
    },
    {
      "name": "Existing status badge",
      "kind": "chip",
      "html": "<span class=\"ds-badge\">Saved</span>",
      "description": "Retained status primitive; uppercase is not a pattern for new decorative headings.",
      "css": ".ds-badge{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:inline-flex;border-radius:9999px;padding:2px 10px;background:var(--color-bg-raised);color:var(--color-ink-soft);font-size:12px;font-weight:600;letter-spacing:.025em;text-transform:uppercase;}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "html": "<div class=\"ds-card\"><p>Worked example</p></div>",
      "description": "Card supplies surface, border, radius, and depth; its caller owns padding.",
      "css": ".ds-card{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;border:1px solid var(--color-border);border-radius:16px;background:var(--color-bg-soft);color:var(--color-ink);box-shadow:var(--shadow-card);}.ds-card p{margin:20px;}"
    },
    {
      "name": "Answer choice",
      "kind": "button",
      "refersTo": "answer-choice",
      "html": "<button class=\"ds-choice\" aria-pressed=\"false\"><span>A</span><span>The starting cost stays the same.</span></button>",
      "css": ".ds-choice{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:flex;width:100%;gap:.85rem;align-items:flex-start;text-align:left;border:1px solid var(--color-border);min-height:58px;border-radius:12px;padding:.9rem 1rem;background:var(--color-bg-soft);color:var(--color-ink);cursor:pointer;}.ds-choice:hover:not(:disabled){border-color:var(--color-brand);}.ds-choice[aria-pressed=\"true\"]{background:var(--color-brand-soft);border-color:var(--color-brand);}.ds-choice[data-correct=\"true\"]{background:var(--color-good-soft);border-color:var(--color-good);}.ds-choice[data-wrong=\"true\"]{background:var(--color-bad-soft);border-color:var(--color-bad);}.ds-choice:focus-visible{outline:3px solid var(--color-brand);outline-offset:3px;}"
    },
    {
      "name": "Learning sequence",
      "kind": "nav",
      "refersTo": "learning-stage-current",
      "description": "Learn / Explore / Practice in the approved lesson footer. Current state is real; checks require completed stages.",
      "html": "<nav class=\"ds-sequence\" aria-label=\"Learning sequence\"><button aria-current=\"step\"><span>Learn</span><i aria-hidden=\"true\"></i></button><button disabled><span>Explore</span><i aria-hidden=\"true\"></i></button><button disabled><span>Practice</span><i aria-hidden=\"true\"></i></button></nav>",
      "css": ".ds-sequence{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:flex;gap:.5rem;}.ds-sequence button{display:flex;align-items:center;gap:.5rem;min-height:44px;padding:.4rem .65rem;border:0;background:transparent;color:var(--color-ink-soft);font-size:.875rem;}.ds-sequence button[aria-current]{color:var(--color-brand);font-weight:750;}.ds-sequence i{width:24px;height:8px;border-radius:99px;background:var(--color-border);}.ds-sequence [aria-current] i{background:var(--color-brand);}.ds-sequence button:disabled{opacity:.7;cursor:default;}.ds-sequence button:focus-visible{outline:3px solid var(--color-brand);outline-offset:3px;}"
    },
    {
      "name": "Approved lesson scene",
      "kind": "custom",
      "refersTo": "lesson-coach",
      "description": "Actual authored source beside one teaching idea; stacks below 900px. Wide introductory explorations use 1.35rem coach padding.",
      "html": "<div class=\"ds-scene\"><section class=\"ds-artifact\"><p>A bike rental costs $3 to start, plus $2 for each hour.</p><p class=\"ds-equation\">3 + 2 \u00d7 2 = 7</p></section><aside class=\"ds-coach\"><h2>First, a smaller step.</h2><p>Keep the $3 starting cost. Add $2 once.</p><p class=\"ds-equation\">$3 + $2 = $5</p><p>This example is unscored. Independent practice uses new questions.</p></aside></div>",
      "css": ".ds-scene{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:14px;color:var(--color-ink);}.ds-artifact{min-width:0;background:var(--color-bg-soft);border:1px solid var(--color-border);border-radius:14px;padding:1.5rem;}.ds-coach{min-width:0;background:var(--subject-reading-soft);border-radius:14px;padding:1.75rem;}.ds-coach h2{font-size:1.85rem;font-weight:850;line-height:1.2;letter-spacing:-.035em;margin:0 0 .75rem;}.ds-coach p{font-size:1.1rem;line-height:1.65;}.ds-equation{font-size:2rem!important;font-weight:850;}@media(min-width:1100px){.ds-coach{padding:1.35rem;}}@media(max-width:900px){.ds-scene{grid-template-columns:1fr;}.ds-artifact,.ds-coach{padding:1.25rem;}}"
    },
    {
      "name": "Campaign round marker",
      "kind": "custom",
      "description": "Round state comes from saved answers; current, correct, review, and next remain distinct.",
      "html": "<div class=\"ds-rounds\" aria-label=\"Mission rounds\"><span aria-label=\"Round 1: current\" data-state=\"current\">1</span><span aria-label=\"Round 2: next\">2</span><span aria-label=\"Round 3: next\">3</span></div>",
      "css": ".ds-rounds{font-family:var(--font-geist-sans),Arial,Helvetica,sans-serif;display:flex;flex-wrap:wrap;gap:.65rem;color:var(--color-ink);}.ds-rounds>span{display:flex;align-items:center;justify-content:center;min-width:40px;height:40px;border-radius:50%;border:2px solid var(--color-border);font-weight:750;}.ds-rounds [data-state=\"current\"]{border-color:var(--color-brand);background:var(--color-brand);color:var(--color-on-brand);box-shadow:0 0 0 4px var(--color-brand-soft);}.ds-rounds [data-state=\"correct\"]{background:var(--subject-english-soft);}.ds-rounds [data-state=\"review\"]{background:var(--subject-reading-soft);}@media(max-width:900px){.ds-rounds{gap:.45rem;}.ds-rounds>span{min-width:32px;height:32px;font-size:.8rem;}}"
    }
  ],
  "narrative": {
    "overview": "The first approved Daily path and focused lesson mockups are binding: `.impeccable/mocks/daily-path.png` and `.impeccable/mocks/lesson-first.png`. The user reaffirmed this exact world and rejected later alternatives. Mona Sans, white/cool-blue surfaces, navy text, cobalt actions, lime/lilac/coral subject roles, the tile mark, and the left navigation remain unchanged.\n\nThe lesson centers a large source artifact beside a lilac coach. One authored idea or example appears at a time; Learn / Explore / Practice progress and a strong next action sit below. The same world carries through drills, exams, formulas, account/auth screens, references, and saved results. Light is the default; an explicit saved dark preference remains valid. The campaign extends this same world with connected missions, earned stars, and full-context answer rounds; it does not replace the approved lesson direction.",
    "keyCharacteristics": [
      "The original approved composition, with no new visual-world choice.",
      "A large authored learning artifact beside a focused lilac coach.",
      "One idea/example at a time, then an unscored check and separate independent practice.",
      "Real saved progress and student-supplied planning settings across phone and laptop."
    ],
    "rules": [
      {
        "name": "The Theme Rule",
        "body": "Use the existing CSS custom properties. The app initializes light to match the approved comp and restores an explicitly saved dark choice before paint. Dark-prefixed tokens describe matching overrides, not a separate visual identity.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "A diagram, color, or highlight must help explain content or state. Keep the underlying text, data, and accessible control available.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do implement the original approved mockups using Mona Sans, shared theme variables, ConceptTeaching, and common task workspaces.",
      "Do show the current idea/example with its exact source evidence and distinguish guided support from independent evidence.",
      "Do preserve saved progress and legacy preferences while requiring new students to supply their own planning values.",
      "Do place concept actions after the evidence, keep content clear of mobile tabs, and honor reduced motion."
    ],
    "donts": [
      "Don't reopen the approved visual-world choice or apply the rejected Fieldwork/Chapters/Orbit directions.",
      "Don't treat a guided check, supported correction, or lesson visit as fresh scored mastery.",
      "Don't copy mockup progress or claim optimal learning, validated score gains, or official ACT affiliation.",
      "Don't reintroduce the old cream/Geist extension-only identity or create Canvas artifacts."
    ]
  }
}
